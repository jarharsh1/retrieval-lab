# RetrieverBench Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# NVIDIA NIM API Key (required for LLM-powered techniques: query rewriting, HyDE, multi-query, agentic RAG)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# ChromaDB (defaults work for Docker Compose setup)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Neo4j (only needed for Technique 10: GraphRAG)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info
